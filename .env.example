# どちらか一つを書く（このファイルを .env という名前で写して使う。.env は git に上げない）
# ① 鍵をここに直接書く
# OPENAI_API_KEY=sk-...
# ② 鍵が書いてある別の .env の場所を書く（GEMu と同じ鍵を使うとき）
# KEY_ENV_FILE=C:\path\to\GEMu_AITuber\.env

# 使うモデル（省略すると gpt-6-luna。画像を読めなければ gpt-4.1-mini に切り替える）
# GAME_MODEL=gpt-6-luna

# Firebase の接続設定（Firebase コンソールの「プロジェクトの設定 → マイアプリ」か、
# firebase apps:sdkconfig WEB で出る値）。書かなければ、ログインなしの手元用として動く
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
