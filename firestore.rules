rules_version = '2';
// ふつうは、画面から Firestore を直接読み書きしない（Cloud Functions＝管理者の権限だけが使う）。
// ただし「ふたりで対戦」の部屋（rooms）だけは、家族のしるし（family。/api/family が付ける）のある人が読み書きできる。
service cloud.firestore {
  match /databases/{database}/documents {
    function family() {
      return request.auth != null && request.auth.token.family == true;
    }
    match /rooms/{room} {
      allow read, write: if family();
      match /{rest=**} {
        allow read, write: if family();
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
