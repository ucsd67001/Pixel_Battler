rules_version = '2';
// ふつうは、画面から Firestore を直接読み書きしない（Cloud Functions＝管理者の権限だけが使う）。
// ただしガレージ（users/{uid}/robots）は、本人だけが見て消せる。
// ただし「ふたりで対戦」の部屋（rooms）は、Google でログインした人ならだれでも使える（2026-11-22 から）。
// 知らない人どうしでも使うので、ほかの人の分を書きかえられないようにしておく：
//   ・部屋にいる人（rooms/main/players/{uid}）は、自分の分だけ書ける。ほかの人の分は、3分より長くいなかった人のものだけ消せる
//   ・バトル（rooms/main の battle）を始められるのは、そのバトルに入っている人だけ（片づけて空にするのは、だれでも）
//   ・技（rooms/main/moves）は、自分の分を新しく書くだけ。あとから直したり消したりはできない
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    match /rooms/{room} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['battle'])
        && (request.resource.data.get('battle', null) == null
          || (resource != null && request.resource.data.battle == resource.data.get('battle', null))
          || request.auth.uid in request.resource.data.battle.p);
      match /players/{uid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['name', 'char', 'seen', 'joined']);
        allow delete: if signedIn() && (uid == request.auth.uid || resource.data.seen < request.time.toMillis() - 180000);
      }
      match /moves/{move} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.by == request.auth.uid;
      }
    }
    // ガレージ（作ったロボ）：見る・消すのは本人だけ。入れるのはサーバーだけ（30体まで・数字はサーバーが計算する）
    match /users/{uid}/robots/{robot} {
      allow read, delete: if signedIn() && uid == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
